# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# Only the public anon key belongs here. NEVER put the service_role key in a VITE_ variable:
# every VITE_* value is bundled into the JavaScript shipped to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
